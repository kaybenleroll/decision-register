{
  "name": "register-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Decision register MCP server, TypeScript build",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node26 --outfile=dist/register.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
