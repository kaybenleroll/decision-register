      "status": "Parked",
      "parked_by": "model"
     }
    ]
   }
  },
  "reopen": {
   "audience": "model",
   "mutating": true,
   "rejects_meta": false,
   "engages_pending": true,
   "description": "Reopen a Resolved item (REQ-36): it becomes Open and every Resolved item depending on it, directly or transitively, becomes Stale; the result lists those ids in stale. Error if the item is not Resolved.",
   "input": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "reason"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     },
     "reason": {
      "$ref": "#/$defs/nonblank"
     }
    }
   },
   "result": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "status",
     "stale"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     },
     "status": {
      "$ref": "#/$defs/status"
     },
     "stale": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/id"
      }
     }
    }
   },
   "examples": {
