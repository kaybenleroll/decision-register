      "id": "q1",
      "status": "Open"
     }
    ]
   }
  },
  "status": {
   "audience": "model",
   "mutating": false,
   "rejects_meta": false,
   "engages_pending": false,
   "description": "Probe and recovery. Reports server_version, tool_schema, lifecycle state, the full tree (open items first, REQ-45), counts, hook-health counts, last event number, resumable, and any recorded version mismatch (REQ-77). Never engages a pending interview and never starts one. journal_schema is kept from spike 3 (A7). The items counts must equal the counts derived from tree by status (Open, Resolved, Parked, Stale); check_contract.py checks this on every good example and C2 scenarios assert it.",
   "input": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {}
   },
   "result": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "server_version",
     "tool_schema",
     "journal_schema",
     "state",
     "interview_id",
     "items",
     "tree",
     "hook_health",
     "last_event",
     "resumable",
     "version_mismatch"
    ],
    "properties": {
     "server_version": {
      "$ref": "#/$defs/nonblank"
     },
     "tool_schema": {
      "$ref": "#/$defs/toolSchema"
     },
     "journal_schema": {
      "const": 2
     },
     "state": {
      "$ref": "#/$defs/state"
     },
     "interview_id": {
      "oneOf": [
       {
        "type": "null"
       },
       {
        "$ref": "#/$defs/id"
       }
      ]
     },
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "open",
       "resolved",
       "parked",
       "stale"
      ],
      "properties": {
       "open": {
        "type": "integer",
        "minimum": 0
       },
       "resolved": {
        "type": "integer",
        "minimum": 0
       },
       "parked": {
        "type": "integer",
        "minimum": 0
       },
       "stale": {
        "type": "integer",
        "minimum": 0
       }
      }
     },
     "tree": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/item"
      }
     },
     "hook_health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "note_prompt",
       "skill_started",
       "check_stop",
       "prompt_seen"
      ],
      "properties": {
       "note_prompt": {
        "type": "integer",
        "minimum": 0
       },
       "skill_started": {
        "type": "integer",
        "minimum": 0
       },
       "check_stop": {
        "type": "integer",
        "minimum": 0
       },
       "prompt_seen": {
        "type": "boolean"
       }
      }
     },
     "last_event": {
      "type": "integer",
      "minimum": 0
     },
     "resumable": {
      "oneOf": [
       {
        "type": "null"
       },
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "interview_id",
         "last_event"
        ],
        "properties": {
         "interview_id": {
          "$ref": "#/$defs/id"
         },
         "last_event": {
          "type": "integer",
          "minimum": 0
         }
        }
       }
      ]
     },
     "version_mismatch": {
      "oneOf": [
       {
        "type": "null"
       },
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "plugin_tool_schema",
         "server_tool_schema"
        ],
        "properties": {
         "plugin_tool_schema": {
          "$ref": "#/$defs/toolSchema"
         },
         "server_tool_schema": {
          "$ref": "#/$defs/toolSchema"
         }
        }
       }
      ]
     }
    }
   },
