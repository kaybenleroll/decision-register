      "id": "q1",
      "reason": "x"
     },
     {
      "id": "q1",
      "reason": "x",
      "parked_by": "assistant"
     },
     {
      "id": "q1",
      "reason": " ",
      "parked_by": "model"
     }
    ],
    "result_good": [
