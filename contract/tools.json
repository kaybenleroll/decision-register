     },
     {
      "note": "counted"
     }
    ]
   }
  },
  "skill_started": {
   "audience": "hook",
   "mutating": false,
   "rejects_meta": true,
   "engages_pending": false,
   "description": "UserPromptExpansion and PreToolUse(Skill) hooks: a skill name exactly matching the configured list starts a pending interview (REQ-20, REQ-24). Never blocks or denies; on a tool_schema mismatch returns {} and records the mismatch for status (REQ-77). Rejects _meta claudecode/toolUseId. Returns empty text or exactly {}.",
   "input": {
    "type": "object",
    "additionalProperties": false,
    "required": [
