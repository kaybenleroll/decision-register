      "id": "q1",
      "answer": "a",
      "source": "model"
     },
     {
      "id": "q1",
      "answer": "",
      "source": "model",
      "rationale": "r"
     },
     {
      "id": "q1",
      "answer": "a",
      "source": "robot",
      "rationale": "r"
     },
     {
      "answer": "a",
      "source": "user",
      "rationale": "r"
     }
    ],
    "result_good": [
     {
      "id": "q1",
      "status": "Resolved"
     }
    ],
    "result_bad": [
     {
      "id": "q1",
      "status": "Done"
     }
    ]
   }
  },
  "park": {
   "audience": "model",
   "mutating": true,
   "rejects_meta": false,
   "engages_pending": true,
   "description": "Park an Open, Stale or model-Parked item (REQ-38). parked_by user is subject to the user-prompt rule (REQ-33); a decision item is parked by user only (REQ-34).",
   "input": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "reason",
     "parked_by"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     },
     "reason": {
      "$ref": "#/$defs/nonblank"
     },
     "parked_by": {
      "$ref": "#/$defs/source"
     }
    }
   },
   "result": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "status"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     },
     "status": {
      "$ref": "#/$defs/status"
     },
     "stale": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/id"
      }
     }
    }
   },
   "examples": {
    "input_good": [
     {
      "id": "q1",
      "reason": "Out of scope",
      "parked_by": "user"
     }
    ],
    "input_bad": [
