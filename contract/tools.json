{
 "tool_schema": 2,
 "journal_schema": 2,
 "conventions": {
  "transport": "MCP over stdio, newline-delimited JSON-RPC 2.0; tools/call result.content[0].text carries the result; failures set result.isError true (a JSON-RPC error is also accepted by the suite).",
  "result_text": "For every tool the text is a JSON object matching result, except that note_prompt and skill_started may return empty text, which counts as {}.",
  "validation": "input and result are JSON Schema (draft 2020-12 subset: type, enum, const, required, properties, additionalProperties, items, minimum, minLength, maxProperties, pattern, oneOf, dependentRequired, $ref to #/$defs). contract/check_contract.py checks them with a stdlib validator.",
  "ids": "Item ids match ^[A-Za-z0-9_.-]{1,64}$. Statuses are capitalised (Open, Resolved, Parked, Stale); the items counts in status use lower-case keys.",
  "unknown_arguments": "Input schemas set additionalProperties false: an unknown argument is an error, so a model-facing tool cannot be handed a session id."
 },
 "$defs": {
  "id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_.-]{1,64}$"
  },
  "nonblank": {
   "type": "string",
   "pattern": "\\S"
  },
  "kind": {
   "enum": [
    "question",
    "subquestion",
    "decision"
   ]
  },
  "status": {
   "enum": [
    "Open",
    "Resolved",
    "Parked",
    "Stale"
   ]
  },
  "source": {
   "enum": [
    "user",
    "model"
   ]
  },
  "state": {
   "enum": [
    "none",
    "pending",
    "active",
    "complete",
    "ended"
   ]
  },
  "toolSchema": {
   "type": "integer",
   "minimum": 1
  },
  "empty_hook_result": {
   "type": "object",
   "maxProperties": 0
  },
  "item": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "kind",
    "text",
    "parent",
    "depends_on",
    "status",
    "answer",
    "source",
    "rationale",
    "parked_by",
    "park_reason"
   ],
   "properties": {
    "id": {
     "$ref": "#/$defs/id"
    },
    "kind": {
     "$ref": "#/$defs/kind"
    },
    "text": {
     "type": "string"
    },
    "parent": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "$ref": "#/$defs/id"
      }
     ]
    },
    "depends_on": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/id"
     }
    },
    "status": {
     "$ref": "#/$defs/status"
    },
    "answer": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "string"
      }
     ]
    },
    "source": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "$ref": "#/$defs/source"
      }
     ]
    },
    "rationale": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "string"
      }
     ]
    },
    "parked_by": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "$ref": "#/$defs/source"
      }
     ]
    },
    "park_reason": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "type": "string"
      }
     ]
    }
   }
  }
 },
 "tools": {
  "begin_interview": {
   "audience": "model",
   "mutating": false,
   "rejects_meta": false,
   "engages_pending": true,
   "description": "Register-mode start by the skill after its status probe (REQ-21). No session id: binds to last_seen_session_id (REQ-27 rule 1). A start while an interview is pending, active or complete in the same session is a no-op returning the existing interview id (REQ-22). Refused while an unfinished journal exists (REQ-52). Error on tool_schema mismatch names both values (REQ-77).",
   "input": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "tool_schema",
     "skill",
     "mode"
    ],
    "properties": {
     "tool_schema": {
      "$ref": "#/$defs/toolSchema"
     },
     "skill": {
      "$ref": "#/$defs/nonblank"
     },
     "mode": {
      "const": "register"
     }
    }
   },
   "result": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "interview_id",
     "state"
    ],
    "properties": {
     "interview_id": {
      "$ref": "#/$defs/id"
     },
     "state": {
      "$ref": "#/$defs/state"
     },
     "existing": {
      "type": "boolean"
     }
    }
   },
   "examples": {
    "input_good": [
     {
      "tool_schema": 2,
      "skill": "grill-me",
      "mode": "register"
     }
    ],
    "input_bad": [
     {
      "tool_schema": 2,
      "skill": "grill-me",
      "mode": "plain"
     },
     {
      "tool_schema": 2,
      "skill": "grill-me",
      "mode": "register",
      "session_id": "s1"
     },
     {
      "skill": "grill-me",
      "mode": "register"
     },
     {
      "tool_schema": "1",
      "skill": "grill-me",
      "mode": "register"
     }
    ],
    "result_good": [
     {
      "interview_id": "iv-1",
      "state": "active",
      "existing": false
     }
    ],
    "result_bad": [
     {
      "interview_id": "iv-1",
      "state": "started"
     },
     {
      "state": "active"
     }
    ]
   }
  },
  "log_item": {
   "audience": "model",
   "mutating": true,
   "rejects_meta": false,
   "engages_pending": true,
   "description": "Log an item. id is an optional caller-supplied label (kept from spike 3); the server assigns one if absent. depends_on ids must already exist. A subquestion requires parent. answer, source and rationale together record a decision the user volunteered (REQ-32); source user is subject to the per-prompt rule.",
   "input": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "text"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     },
     "kind": {
      "$ref": "#/$defs/kind"
     },
     "text": {
      "$ref": "#/$defs/nonblank"
     },
     "parent": {
      "$ref": "#/$defs/id"
     },
     "depends_on": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/id"
      }
     },
     "answer": {
      "$ref": "#/$defs/nonblank"
     },
     "source": {
      "$ref": "#/$defs/source"
     },
     "rationale": {
      "type": "string",
      "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
     }
    },
    "dependentRequired": {
     "answer": [
      "source",
      "rationale"
     ],
     "source": [
      "answer",
      "rationale"
     ],
     "rationale": [
      "answer",
      "source"
     ]
    }
   },
   "result": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "status"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     },
     "status": {
      "$ref": "#/$defs/status"
     },
     "stale": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/id"
      }
     }
    }
   },
   "examples": {
    "input_good": [
     {
      "kind": "question",
      "text": "Which store?"
     },
     {
      "id": "q2",
      "kind": "subquestion",
      "text": "Sub",
      "parent": "q1",
      "depends_on": [
       "q1"
      ]
     },
     {
      "kind": "decision",
      "text": "Use X",
      "answer": "X",
      "source": "user",
      "rationale": "User said so"
     }
    ],
    "input_bad": [
     {
      "kind": "topic",
      "text": "x"
     },
     {
      "kind": "question",
      "text": "   "
     },
     {
      "kind": "question"
     },
     {
      "kind": "question",
      "text": "t",
      "answer": "a"
     },
     {
      "kind": "question",
      "text": "t",
      "answer": "a",
      "source": "model",
      "rationale": "two\nlines"
     },
     {
      "kind": "question",
      "text": "t",
      "depends_on": "q1"
     },
     {
      "kind": "question",
      "text": "t",
      "id": "bad id"
     }
    ],
    "result_good": [
     {
      "id": "q1",
      "status": "Open"
     },
     {
      "id": "q2",
      "status": "Resolved"
     }
    ],
    "result_bad": [
     {
      "id": "q1"
     },
     {
      "id": "q1",
      "status": "open"
     }
    ]
   }
  },
  "resolve": {
   "audience": "model",
   "mutating": true,
   "rejects_meta": false,
   "engages_pending": true,
   "description": "Resolve an Open, Stale or Parked item (REQ-38). answer, source and rationale are all required (REQ-31). source user needs a user prompt since the item's last model action (REQ-32); a decision item takes source user only (REQ-34).",
   "input": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "answer",
     "source",
     "rationale"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     },
     "answer": {
      "$ref": "#/$defs/nonblank"
     },
     "source": {
      "$ref": "#/$defs/source"
     },
     "rationale": {
      "type": "string",
      "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"
     }
    }
   },
   "result": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "status"
    ],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     },
     "status": {
      "$ref": "#/$defs/status"
     },
     "stale": {
      "type": "array",
      "items": {
       "$ref": "#/$defs/id"
      }
     }
    }
   },
   "examples": {
    "input_good": [
     {
      "id": "q1",
      "answer": "Postgres",
      "source": "model",
      "rationale": "Only store with the feature"
     }
    ],
    "input_bad": [
