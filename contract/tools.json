  },
  "check_stop": {
   "audience": "hook",
   "mutating": false,
   "rejects_meta": true,
   "engages_pending": false,
   "description": "Stop hook: records last_seen_session_id, classifies the turn and applies the finish gate (REQ-42, REQ-43). Returns {} to allow or a block decision whose reason names the open items (first 10, text truncated to 120 characters, REQ-45). Rejects _meta claudecode/toolUseId. Fails open.",
   "input": {
