 },
 "errors": [
  {
   "tools": "begin_interview",
   "when": "tool_schema differs from the server's",
   "message_names": "both values, plugin and server (REQ-77)"
  },
  {
   "tools": "begin_interview|log_item|resolve|park|reopen",
   "when": "an unfinished journal exists",
   "message_names": "unfinished journal: call resume or discard"
  },
  {
   "tools": "resolve|park|reopen",
   "when": "transition not allowed by REQ-38",
   "message_names": "the item id and its current status"
  },
  {
   "tools": "log_item",
   "when": "depends_on or parent names a missing item",
   "message_names": "the missing id"
  },
  {
   "tools": "resolve",
   "when": "decision item with source model; or REQ-35 parent with fewer than N children and source model",
   "message_names": "the item id"
  },
  {
   "tools": "park",
   "when": "decision item with parked_by model",
   "message_names": "the item id"
  },
  {
   "tools": "resolve|park|log_item",
   "when": "source or parked_by user without a user prompt since the budget point",
   "message_names": "a message saying so; when no prompt hook call was ever seen, a message saying hooks are not firing (REQ-44)"
  },
  {
   "tools": "log_item",
   "when": "a caller-supplied id is already used by an item in this interview",
   "message_names": "the duplicate id, e.g. \"duplicate id: q1\"; nothing is logged and no journal event is written"
  },
  {
   "tools": "end_interview",
   "when": "items open without abandon true and a reason",
   "message_names": "the open item ids"
  },
  {
   "tools": "resume",
   "when": "journal already claimed; several unfinished journals and no id; state not none or pending; replay failure",
   "message_names": "journal already claimed | the list of interview ids | the state | the 1-based line number as a digit string"
  },
  {
   "tools": "note_prompt|skill_started|check_stop",
   "when": "call carries _meta claudecode/toolUseId",
   "message_names": "the tool name and 'hook-facing'"
  }
 ]
}
