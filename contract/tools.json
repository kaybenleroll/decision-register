  "resume": {
   "audience": "model",
   "mutating": false,
   "rejects_meta": false,
   "engages_pending": false,
   "description": "Resume an unfinished journal (REQ-52): accepted only in state none or pending; rebinds to last_seen_session_id; claims the pid file exclusively. id may be omitted when exactly one unfinished journal exists; when several exist the error lists them. Replay failure names the 1-based line number and leaves state unchanged (REQ-60). Not a start-engaging call.",
   "input": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     }
    }
   },
   "result": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "interview_id",
     "state",
     "last_event",
     "items"
    ],
    "properties": {
     "interview_id": {
      "$ref": "#/$defs/id"
     },
     "state": {
      "$ref": "#/$defs/state"
     },
     "last_event": {
      "type": "integer",
      "minimum": 0
     },
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "open",
       "resolved",
       "parked",
       "stale"
      ],
      "properties": {
       "open": {
        "type": "integer",
        "minimum": 0
       },
       "resolved": {
        "type": "integer",
        "minimum": 0
       },
       "parked": {
        "type": "integer",
        "minimum": 0
       },
       "stale": {
        "type": "integer",
        "minimum": 0
       }
      }
     }
    }
   },
   "examples": {
    "input_good": [
     {},
     {
      "id": "iv-1"
     }
    ],
    "input_bad": [
     {
      "id": ""
     },
     {
      "interview_id": "iv-1"
     }
    ],
    "result_good": [
     {
      "interview_id": "iv-1",
      "state": "active",
      "last_event": 7,
      "items": {
       "open": 1,
       "resolved": 2,
       "parked": 0,
       "stale": 0
      }
     }
    ],
    "result_bad": [
     {
      "interview_id": "iv-1",
      "state": "active"
     }
    ]
   }
  },
  "discard": {
   "audience": "model",
   "mutating": false,
   "rejects_meta": false,
   "engages_pending": false,
   "description": "Archive an unfinished journal and continue plain (REQ-52). id may be omitted when exactly one unfinished journal exists.",
   "input": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
     "id": {
      "$ref": "#/$defs/id"
     }
    }
   },
   "result": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "interview_id",
     "archived"
    ],
    "properties": {
     "interview_id": {
      "$ref": "#/$defs/id"
     },
     "archived": {
      "const": true
     }
    }
   },
   "examples": {
    "input_good": [
     {},
     {
      "id": "iv-1"
     }
    ],
    "input_bad": [
     {
      "id": 5
     }
    ],
    "result_good": [
     {
      "interview_id": "iv-1",
      "archived": true
     }
    ],
    "result_bad": [
     {
      "interview_id": "iv-1",
      "archived": false
     }
    ]
   }
  },
  "end_interview": {
   "audience": "model",
   "mutating": false,
   "rejects_meta": false,
   "engages_pending": false,
   "description": "End the interview (REQ-23). Refused while items are open unless abandon is true with a non-blank reason. end_kind: normal = active, nothing open; ended_incomplete_by_model = abandon true with a reason while items are open; ended_after_completion = complete interview; stood_down = mode plain on a pending interview; abandoned = session change only (never returned by this tool); interrupted is a decision-log kind and never returned. mode plain stands a pending interview down without flagging it incomplete (REQ-27 rule 3). Not a start-engaging call.",
   "input": {
    "type": "object",
    "additionalProperties": false,
    "required": [],
    "properties": {
     "abandon": {
      "type": "boolean"
     },
     "reason": {
      "$ref": "#/$defs/nonblank"
     },
     "mode": {
      "const": "plain"
     }
    }
   },
   "result": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "interview_id",
     "state",
     "end_kind"
    ],
    "properties": {
     "interview_id": {
      "$ref": "#/$defs/id"
     },
     "state": {
      "const": "ended"
     },
     "end_kind": {
      "enum": [
       "normal",
       "ended_after_completion",
       "ended_incomplete_by_model",
       "abandoned",
       "stood_down"
      ]
     }
    }
   },
   "examples": {
    "input_good": [
     {},
     {
      "abandon": true,
      "reason": "User left"
     },
     {
      "mode": "plain"
     }
    ],
    "input_bad": [
     {
      "abandon": "yes"
     },
     {
      "mode": "register"
     },
     {
      "reason": ""
     }
    ],
    "result_good": [
     {
      "interview_id": "iv-1",
      "state": "ended",
      "end_kind": "normal"
     }
    ],
    "result_bad": [
     {
      "interview_id": "iv-1",
      "state": "ended",
      "end_kind": "finished"
     }
    ]
   }
  },
  "note_prompt": {
   "audience": "hook",
   "mutating": false,
   "rejects_meta": true,
   "engages_pending": false,
   "description": "UserPromptSubmit hook: counts a user prompt and records last_seen_session_id, even when no interview is active (REQ-13, REQ-27). Rejects any call carrying _meta claudecode/toolUseId. Returns empty text or exactly {} (REQ-41).",
   "input": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "session_id",
     "prompt"
    ],
    "properties": {
     "session_id": {
      "$ref": "#/$defs/nonblank"
     },
     "prompt": {
      "type": "string"
     }
    }
   },
   "result": {
    "$ref": "#/$defs/empty_hook_result"
   },
   "examples": {
