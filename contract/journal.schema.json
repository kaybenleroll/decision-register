{
 "journal_schema": 2,
 "description": "Machine-readable form of contract/journal.md (the event envelope and the 13 event kinds). `kinds` maps each kind to the JSON Schema (same subset as tools.json) of one journal line; a $ref names a definition in this file's $defs or in tools.json's $defs (id, nonblank, oneline, kind, source, toolSchema). The runner validates every line of a journal against kinds[line.kind], requires seq 1..n gapless and a `start` first event. Version 1 lines (no v, ts, seq) are replay input only and are not described here. contract/check_contract.py checks this file against journal.md and its own examples.",
 "$defs": {
  "ts": {
   "type": "string",
   "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(\\.\\d+)?(Z|\\+00:00)$"
  }
 },
 "kinds": {
  "start": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "v",
    "ts",
    "seq",
    "kind",
    "interview_id",
    "route",
    "skill",
    "session_id",
    "implicit",
    "prompt_count"
   ],
   "properties": {
    "v": {
     "const": 2
    },
    "ts": {
     "$ref": "#/$defs/ts"
    },
    "seq": {
     "type": "integer",
     "minimum": 1
    },
    "kind": {
     "const": "start"
    },
    "interview_id": {
     "$ref": "#/$defs/id"
    },
    "route": {
     "enum": [
      "hook",
      "begin_interview",
      "implicit"
     ]
    },
    "skill": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "$ref": "#/$defs/nonblank"
      }
     ]
    },
    "session_id": {
     "oneOf": [
      {
       "type": "null"
      },
      {
       "$ref": "#/$defs/nonblank"
      }
     ]
    },
    "implicit": {
     "type": "boolean"
    },
    "prompt_count": {
     "type": "integer",
     "enum": [
      0,
      1
     ]
    }
   },
   "oneOf": [
    {
     "required": [
      "route",
      "skill",
      "implicit"
     ],
     "properties": {
      "route": {
       "const": "implicit"
      },
      "skill": {
       "type": "null"
      },
      "implicit": {
       "const": true
      }
     }
    },
    {
     "required": [
      "route",
      "skill",
      "implicit"
     ],
     "properties": {
      "route": {
       "enum": [
        "hook",
        "begin_interview"
       ]
      },
      "skill": {
       "$ref": "#/$defs/nonblank"
      },
      "implicit": {
       "const": false
      }
     }
    }
   ]
  },
  "engage": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "v",
    "ts",
    "seq",
    "kind",
    "via",
    "skill"
   ],
   "properties": {
    "v": {
