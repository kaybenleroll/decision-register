{
 "id": "S-52e",
 "title": "graceful exit (stdin EOF): an active interview with open items keeps its journal unfinished (no end event), loses its pid file and gets a log flagged interrupted; a complete interview is archived with an end event and keeps its log",
 "req": [
  "REQ-27",
  "REQ-23",
  "REQ-52",
  "REQ-60"
 ],
 "steps": [
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-52e",
    "prompt": "my answer is below"
   }
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 4,
    "skill": "grill-me",
    "mode": "register"
   },
   "save": {
    "iid": "interview_id"
   }
  },
  {
   "call": "log_item",
   "args": {
    "kind": "question",
    "text": "open"
   }
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-52e",
    "last_assistant_message": "Q1: open?"
   },
   "assert": [
    {
     "decision_block": false
    }
   ]
  },
  {
   "op": "stop"
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "$key/${iid}.jsonl"
    },
    {
     "path": "$key/${iid}.pid",
     "exists": false
    },
    {
     "path": "$key/archive/${iid}.jsonl",
     "exists": false
    }
   ]
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "decision-logs/decision-${iid}.md",
     "root": "project",
     "matches": "(?s)\\Ainterview_id: ${iid}\njournal_position: [^\\n]+\nstate: [^\\n]+\nmode: register\nend_kind: interrupted\nimplicit_start: [^\\n]+\n",
     "mode": "600"
    }
   ]
  },
  {
   "op": "journal",
   "action": "load"
  },
  {
   "op": "journal",
   "action": "check_events",
   "ended": false
  },
  {
   "op": "journal",
   "action": "assert_events",
   "count": {
    "end": 0
   }
  },
  {
   "op": "start"
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "none"
    },
    {
     "path": "resumable.0.interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "call": "resume",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "call": "resolve",
   "args": {
    "id": "Q1",
    "answer": "an",
    "source": "model",
    "rationale": "why"
   }
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-52e",
    "last_assistant_message": "all done"
   },
   "assert": [
    {
     "decision_block": false
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "complete"
    }
   ]
  },
  {
   "op": "stop"
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "$key/${iid}.jsonl",
     "exists": false
    },
    {
     "path": "$key/${iid}.pid",
     "exists": false
    },
    {
     "path": "$key/archive/${iid}.jsonl",
     "nonempty": true
    }
   ]
  },
  {
   "op": "journal",
   "action": "load",
   "where": "archive"
  },
  {
   "op": "journal",
   "action": "check_events",
   "ended": true
  },
  {
   "op": "journal",
   "action": "assert_events",
   "count": {
    "end": 1
   },
   "last": {
    "kind": "end",
    "end_kind": "ended_after_completion",
    "mode": "register"
   }
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "decision-logs/decision-${iid}.md",
     "root": "project",
     "matches": "(?s)\\Ainterview_id: ${iid}\njournal_position: [^\\n]+\nstate: [^\\n]+\nmode: register\nend_kind: ended_after_completion\nimplicit_start: [^\\n]+\n"
    }
   ]
  },
  {
   "op": "start"
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "none"
    },
    {
     "path": "resumable",
     "eq": []
    }
   ]
  }
 ]
}
