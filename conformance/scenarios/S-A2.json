{
 "id": "S-A2",
 "title": "reopen on an Open item errors naming id and status; unknown ids error naming the id; a failing call changes nothing",
 "req": [
  "REQ-36",
  "REQ-38",
  "REQ-30",
  "REQ-40"
 ],
 "steps": [
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-a2",
    "prompt": "grill me on this plan"
   }
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 3,
    "skill": "grill-me",
    "mode": "register"
   },
   "save": {
    "iid": "interview_id"
   }
  },
  {
   "call": "log_item",
   "args": {
    "id": "q1",
    "kind": "question",
    "text": "text-one"
   }
  },
  {
   "call": "reopen",
   "args": {
    "id": "q1",
    "reason": "r"
   },
   "expect": "error",
   "mention": [
    "q1",
    "Open"
   ]
  },
  {
   "call": "log_item",
   "args": {
    "id": "q2",
    "kind": "question",
    "text": "t",
    "depends_on": [
     "nope"
    ]
   },
   "expect": "error",
   "mention": "nope"
  },
  {
   "call": "resolve",
   "args": {
    "id": "zz",
    "answer": "a",
    "source": "model",
    "rationale": "r"
   },
   "expect": "error",
   "mention": "zz"
  },
  {
   "call": "log_item",
   "args": {
    "id": "q1",
    "kind": "question",
    "text": "text-dup"
   },
   "expect": "error",
   "mention": "q1",
   "matches": "(?i)duplicate"
  },
  {
   "call": "log_item",
   "args": {
    "kind": "question",
    "text": "   "
   },
   "expect": "error",
   "matches": "^invalid arguments:.*text"
  },
  {
   "call": "log_item",
   "args": {
    "kind": "question",
    "text": "t",
    "bogus": 1
   },
   "expect": "error",
   "matches": "^invalid arguments:.*bogus"
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "items",
     "eq": {
      "open": 1,
      "resolved": 0,
      "parked": 0,
      "stale": 0
     }
    },
    {
     "path": "tree",
     "len": 1
    },
    {
     "path": "tree.0.text",
     "eq": "text-one"
    },
    {
     "path": "last_event",
     "eq": 2
    }
   ]
  }
 ]
}
