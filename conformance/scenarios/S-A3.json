{
 "id": "S-A3",
 "title": "finish gate blocks with Stale items open and names them with their text, not resolved items",
 "req": [
  "REQ-42",
  "REQ-43",
  "REQ-45"
 ],
 "steps": [
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-a3",
    "prompt": "grill me on this plan"
   }
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 3,
    "skill": "grill-me",
    "mode": "register"
   },
   "save": {
    "iid": "interview_id"
   }
  },
  {
   "call": "log_item",
   "args": {
    "id": "q1",
    "kind": "question",
    "text": "text-one"
   }
  },
  {
   "call": "log_item",
   "args": {
    "id": "q2",
    "kind": "question",
    "text": "text-two",
    "depends_on": [
     "q1"
    ]
   }
  },
  {
   "call": "log_item",
   "args": {
    "id": "q3",
    "kind": "question",
    "text": "text-three",
    "depends_on": [
     "q2"
    ]
   }
  },
  {
   "call": "resolve",
   "args": {
    "id": "q1",
    "answer": "a1",
    "source": "model",
    "rationale": "r"
   }
  },
  {
   "call": "resolve",
   "args": {
    "id": "q2",
    "answer": "a2",
    "source": "model",
    "rationale": "r"
   }
  },
  {
   "call": "resolve",
   "args": {
    "id": "q3",
    "answer": "a3",
    "source": "model",
    "rationale": "r"
   }
  },
  {
   "call": "reopen",
   "args": {
    "id": "q1",
    "reason": "r"
   }
  },
  {
   "call": "resolve",
   "args": {
    "id": "q1",
    "answer": "a1b",
    "source": "model",
    "rationale": "r"
   }
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "items",
     "eq": {
      "open": 0,
      "resolved": 1,
      "parked": 0,
      "stale": 2
     }
    }
   ]
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-a3",
    "last_assistant_message": "done"
   },
   "assert": [
    {
     "decision_block": true
    },
    {
     "path": "reason",
     "contains": "q2"
    },
    {
     "path": "reason",
     "contains": "text-two"
    },
    {
     "path": "reason",
     "contains": "q3"
    },
    {
     "path": "reason",
     "contains": "text-three"
    },
    {
     "path": "reason",
     "not_contains": "q1"
    },
    {
     "path": "reason",
     "not_contains": "text-one"
    },
    {
     "path": "reason",
     "not_contains": "q99"
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "hook_health.check_stop",
     "eq": 1
    },
    {
     "path": "items",
     "eq": {
      "open": 0,
      "resolved": 1,
      "parked": 0,
      "stale": 2
     }
    }
   ]
  }
 ]
}
