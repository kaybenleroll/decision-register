{
 "id": "S-L2",
 "title": "without CLAUDE_PLUGIN_DATA the journal uses the temp directory with the same layout",
 "req": [
  "REQ-61"
 ],
 "env": {
  "TMPDIR": "$dir"
 },
 "unset_env": [
  "CLAUDE_PLUGIN_DATA"
 ],
 "steps": [
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 3,
    "skill": "grill-me",
    "mode": "register"
   },
   "save": {
    "iid": "interview_id"
   }
  },
  {
   "call": "log_item",
   "args": {
    "id": "q1",
    "kind": "question",
    "text": "tq1"
   }
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "",
     "mode": "700"
    },
    {
     "path": "$key",
     "mode": "700"
    },
    {
     "path": "$key/$iid.jsonl",
     "mode": "600"
    },
    {
     "path": "$key/$iid.pid",
     "mode": "600"
    }
   ]
  }
 ]
}
