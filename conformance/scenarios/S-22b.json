{
 "id": "S-22b",
 "title": "a start while an interview is pending, active or complete (skill_started with the listed name, or begin_interview) is a no-op returning the existing id with state and register intact",
 "req": [
  "REQ-22"
 ],
 "steps": [
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-22b",
    "prompt": "my answer is below"
   }
  },
  {
   "call": "skill_started",
   "args": {
    "tool_schema": 5,
    "session_id": "sess-22b",
    "skill": "grill-me"
   }
  },
  {
   "call": "status",
   "args": {},
   "save": {
    "iid": "interview_id"
   },
   "assert": [
    {
     "path": "state",
     "eq": "pending"
    }
   ]
  },
  {
   "call": "skill_started",
   "args": {
    "tool_schema": 5,
    "session_id": "sess-22b",
    "skill": "grill-me"
   }
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "pending"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 5,
    "skill": "grill-me",
    "mode": "register"
   },
   "save": {
    "iid": "interview_id"
   }
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "call": "log_item",
   "args": {
    "id": "q1",
    "kind": "question",
    "text": "kept item"
   }
  },
  {
   "call": "resolve",
   "args": {
    "id": "q1",
    "answer": "an",
    "source": "model",
    "rationale": "why"
   }
  },
  {
   "call": "log_item",
   "args": {
    "id": "q2",
    "kind": "question",
    "text": "second item"
   }
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 5,
    "skill": "other",
    "mode": "register"
   },
   "assert": [
    {
     "path": "existing",
     "eq": true
    },
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "call": "skill_started",
   "args": {
    "tool_schema": 5,
    "session_id": "sess-22b",
    "skill": "grill-me"
   }
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    },
    {
     "path": "items",
     "eq": {
      "open": 1,
      "resolved": 1,
      "parked": 0,
      "stale": 0
     }
    },
    {
     "path": "tree.0.id",
     "eq": "q2"
    },
    {
     "path": "tree.1.id",
     "eq": "q1"
    }
   ]
  },
  {
   "call": "resolve",
   "args": {
    "id": "q2",
    "answer": "an",
    "source": "model",
    "rationale": "why"
   }
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-22b",
    "last_assistant_message": "all done"
   },
   "assert": [
    {
     "decision_block": false
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "complete"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    },
    {
     "path": "items",
     "eq": {
      "open": 0,
      "resolved": 2,
      "parked": 0,
      "stale": 0
     }
    }
   ]
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 5,
    "skill": "grill-me",
    "mode": "register"
   },
   "assert": [
    {
     "path": "existing",
     "eq": true
    },
    {
     "path": "state",
     "eq": "complete"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "call": "skill_started",
   "args": {
    "tool_schema": 5,
    "session_id": "sess-22b",
    "skill": "grill-me"
   }
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "complete"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    },
    {
     "path": "items",
     "eq": {
      "open": 0,
      "resolved": 2,
      "parked": 0,
      "stale": 0
     }
    },
    {
     "path": "last_event",
     "ge": 1
    }
   ]
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-22b",
    "last_assistant_message": "chat"
   },
   "assert": [
    {
     "decision_block": false
    }
   ]
  },
  {
   "op": "journal",
   "action": "load"
  },
  {
   "op": "journal",
   "action": "assert_events",
   "count": {
    "start": 1,
    "complete": 1
   }
  }
 ]
}
