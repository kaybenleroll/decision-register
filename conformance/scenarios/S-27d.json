{
 "id": "S-27d",
 "title": "end_interview with mode plain stands a pending interview down at once: result stood_down, not flagged incomplete, log mode plain, journal archived, gate off afterwards",
 "req": [
  "REQ-27",
  "REQ-23",
  "REQ-62"
 ],
 "steps": [
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-27d",
    "prompt": "my answer is below"
   }
  },
  {
   "call": "skill_started",
   "args": {
    "tool_schema": 5,
    "session_id": "sess-27d",
    "skill": "grill-me"
   }
  },
  {
   "call": "status",
   "args": {},
   "save": {
    "iid": "interview_id"
   },
   "assert": [
    {
     "path": "state",
     "eq": "pending"
    }
   ]
  },
  {
   "call": "end_interview",
   "args": {
    "mode": "plain"
   },
   "assert": [
    {
     "path": "state",
     "eq": "ended"
    },
    {
     "path": "end_kind",
     "eq": "stood_down"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    },
    {
     "path": "decision_log",
     "matches": "decision-${iid}\\.md$"
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "none"
    },
    {
     "path": "interview_id",
     "eq": null
    }
   ]
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "decision-logs/decision-${iid}.md",
     "root": "project",
     "matches": "(?s)\\Ainterview_id: ${iid}\njournal_position: [^\\n]+\nstate: ended\nmode: plain\nend_kind: stood_down\nimplicit_start: false\n",
     "mode": "600"
    }
   ]
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "$key/${iid}.jsonl",
     "exists": false
    },
    {
     "path": "$key/${iid}.pid",
     "exists": false
    },
    {
     "path": "$key/archive/${iid}.jsonl",
     "nonempty": true
    }
   ]
  },
  {
   "op": "journal",
   "action": "load",
   "where": "archive"
  },
  {
   "op": "journal",
   "action": "check_events",
   "ended": true
  },
  {
   "op": "journal",
   "action": "assert_events",
   "count": {
    "start": 1,
    "end": 1
   },
   "last": {
    "kind": "end",
    "end_kind": "stood_down",
    "mode": "plain"
   }
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-27d",
    "last_assistant_message": "Is this right?"
   },
   "assert": [
    {
     "decision_block": false
    }
   ]
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-27d",
    "last_assistant_message": "Is this right?"
   },
   "assert": [
    {
     "decision_block": false
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "none"
    }
   ]
  }
 ]
}
