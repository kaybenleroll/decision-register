{
 "id": "S-15f",
 "title": "resume takes an optional skill: given, it becomes the resumed interview's owner_skill and is journalled on the resume event, and a later resume without skill restores that owner; without it the owner recorded in the journal (the start skill) is restored",
 "req": [
  "REQ-15",
  "REQ-22",
  "REQ-27",
  "REQ-52"
 ],
 "steps": [
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-15f",
    "prompt": "hi"
   }
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 5,
    "skill": "grill-me",
    "mode": "register"
   },
   "save": {
    "iid": "interview_id"
   }
  },
  {
   "call": "log_item",
   "args": {
    "kind": "question",
    "text": "open 1"
   }
  },
  {
   "op": "kill"
  },
  {
   "op": "start"
  },
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-15f-2",
    "prompt": "hi"
   }
  },
  {
   "call": "resume",
   "args": {},
   "assert": [
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "owner_skill",
     "eq": "grill-me"
    }
   ]
  },
  {
   "op": "kill"
  },
  {
   "op": "start"
  },
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-15f-3",
    "prompt": "hi"
   }
  },
  {
   "call": "resume",
   "args": {
    "skill": "query-walkthrough"
   },
   "assert": [
    {
     "path": "interview_id",
     "eq": "$iid"
    },
    {
     "path": "state",
     "eq": "active"
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "owner_skill",
     "eq": "query-walkthrough"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "op": "journal",
   "action": "load"
  },
  {
   "op": "journal",
   "action": "assert_events",
   "last": {
    "kind": "resume",
    "skill": "query-walkthrough"
   },
   "count": {
    "resume": 2
   }
  },
  {
   "op": "journal",
   "action": "check_events",
   "ended": false
  },
  {
   "op": "kill"
  },
  {
   "op": "start"
  },
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-15f-4",
    "prompt": "hi"
   }
  },
  {
   "call": "resume",
   "args": {}
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "owner_skill",
     "eq": "query-walkthrough"
    },
    {
     "path": "interview_id",
