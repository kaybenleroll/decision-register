{
 "id": "S-L1",
 "title": "journal layout under a verbatim project path, user-only permissions, pid file content and archive move with content",
 "req": [
  "REQ-61",
  "REQ-23",
  "REQ-27",
  "REQ-52",
  "REQ-60"
 ],
 "env": {
  "CLAUDE_PROJECT_DIR": "$dir/cwd/../project/"
 },
 "steps": [
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 3,
    "skill": "grill-me",
    "mode": "register"
   },
   "save": {
    "iid": "interview_id"
   }
  },
  {
   "call": "log_item",
   "args": {
    "id": "q1",
    "kind": "question",
    "text": "tq1"
   }
  },
  {
   "call": "log_item",
   "args": {
    "id": "q2",
    "kind": "question",
    "text": "tq2"
   }
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-l1",
    "last_assistant_message": "all done"
   },
   "assert": [
    {
     "decision_block": true
    }
   ]
  },
  {
   "op": "journal",
   "action": "load",
   "into": "pre"
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "$key",
     "mode": "700"
    },
    {
     "path": "$key/$iid.jsonl",
     "mode": "600"
    },
    {
     "path": "$key/$iid.pid",
     "mode": "600",
     "matches": "^\\{\\s*\"pid\"\\s*:\\s*${pid}\\s*,\\s*\"start\"\\s*:\\s*(\\d+|null)\\s*,\\s*\"interview_id\"\\s*:\\s*\"${iid}\"\\s*\\}\\s*\\n$"
    },
    {
     "path": "$key/archive/$iid.jsonl",
     "exists": false
    }
   ]
  },
  {
   "call": "resolve",
   "args": {
    "id": "q1",
    "answer": "a1",
    "source": "model",
    "rationale": "r1"
   }
  },
  {
   "call": "resolve",
   "args": {
    "id": "q2",
    "answer": "a2",
    "source": "model",
    "rationale": "r2"
   }
  },
  {
   "call": "end_interview",
   "args": {},
   "assert": [
    {
     "path": "end_kind",
     "eq": "normal"
    },
    {
     "path": "state",
     "eq": "ended"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "$key/$iid.jsonl",
     "exists": false
    },
    {
     "path": "$key/$iid.pid",
     "exists": false
    },
    {
     "path": "$key/archive",
     "mode": "700"
    },
    {
     "path": "$key/archive/$iid.jsonl",
     "mode": "600",
     "nonempty": true
    }
   ]
  },
  {
   "op": "journal",
   "action": "load",
   "where": "archive",
   "into": "arch"
  },
  {
   "op": "journal",
   "action": "check_events",
   "from": "arch",
   "ended": true
  },
  {
   "op": "journal",
   "action": "assert_events",
   "from": "arch",
   "prefix": "pre",
   "count": {
    "end": 1,
    "resolve": 2
   },
   "last": {
    "kind": "end",
    "end_kind": "normal",
    "mode": "register"
   }
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "none"
    },
    {
     "path": "interview_id",
     "eq": null
    }
   ]
  }
 ]
}
