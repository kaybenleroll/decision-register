{
 "id": "S-77a",
 "title": "status returns the server version and the integer tool_schema (4) and journal_schema (2) in every state",
 "req": [
  "REQ-77"
 ],
 "steps": [
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "tool_schema",
     "eq": 4
    },
    {
     "path": "journal_schema",
     "eq": 2
    },
    {
     "path": "server_version",
     "matches": "\\S"
    },
    {
     "path": "state",
     "eq": "none"
    }
   ]
  },
  {
   "call": "skill_started",
   "args": {
    "tool_schema": 4,
    "session_id": "sess-77a",
    "skill": "grill-me"
   }
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "tool_schema",
     "eq": 4
    },
    {
     "path": "server_version",
     "matches": "\\S"
    },
    {
     "path": "state",
     "eq": "pending"
    }
   ]
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 4,
    "skill": "grill-me",
    "mode": "register"
   },
   "save": {
    "iid": "interview_id"
   }
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "tool_schema",
     "eq": 4
    },
    {
     "path": "journal_schema",
     "eq": 2
    },
    {
     "path": "server_version",
     "matches": "\\S"
    },
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "version_mismatch",
     "eq": null
    }
   ]
  }
 ]
}
