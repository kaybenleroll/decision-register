{
 "id": "S-15e",
 "title": "begin_interview CLAIMS an implicit (ownerless) active interview: owner_skill is null after the implicit start, becomes the caller at the first begin_interview (existing true, state active), stays with it against later skills, the claim is journalled, and a resume without skill restores the claimant",
 "req": [
  "REQ-15",
  "REQ-22",
  "REQ-27",
  "REQ-21",
  "REQ-52"
 ],
 "steps": [
  {
   "call": "log_item",
   "args": {
    "id": "q1",
    "kind": "question",
    "text": "text-one"
   }
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "owner_skill",
     "eq": null
    }
   ]
  },
  {
