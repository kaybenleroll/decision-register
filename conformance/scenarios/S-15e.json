     "eq": true
    },
    {
     "path": "state",
     "eq": "active"
    }
   ],
   "save": {
    "iid": "interview_id"
   }
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "owner_skill",
     "eq": "grill-me"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 5,
    "skill": "query-walkthrough",
    "mode": "register"
   },
   "assert": [
    {
     "path": "existing",
     "eq": true
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "owner_skill",
     "eq": "grill-me"
    }
   ]
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-15e",
    "last_assistant_message": "hm?"
   }
  },
  {
   "op": "journal",
   "action": "load"
  },
  {
   "op": "journal",
   "action": "assert_events",
   "events": [
    {
     "kind": "start",
     "implicit": true,
     "skill": null
    },
    {
     "kind": "engage",
     "via": "begin_interview",
     "skill": "grill-me"
    }
   ],
   "count": {
    "engage": 1
   }
  },
  {
   "op": "journal",
   "action": "check_events",
   "ended": false
  },
  {
   "op": "kill"
  },
  {
   "op": "start"
  },
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-15e-2",
    "prompt": "hi"
   }
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "none"
    },
    {
     "path": "owner_skill",
     "eq": null
    }
   ]
  },
  {
   "call": "resume",
   "args": {},
   "assert": [
    {
     "path": "interview_id",
     "eq": "$iid"
    },
    {
     "path": "state",
     "eq": "active"
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "owner_skill",
     "eq": "grill-me"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "op": "stop"
  }
 ]
