{
 "id": "S-A8",
 "title": "a hook-started interview is pending; begin_interview engages it (active, existing true, same id) and the journal says so",
 "req": [
  "REQ-20",
  "REQ-27",
  "REQ-22",
  "REQ-60"
 ],
 "steps": [
  {
   "call": "skill_started",
   "args": {
    "tool_schema": 5,
    "session_id": "sess-a8",
    "skill": "grill-me"
   }
  },
  {
   "call": "status",
   "args": {},
   "save": {
    "iid": "interview_id"
   },
   "assert": [
    {
     "path": "state",
     "eq": "pending"
    },
    {
     "path": "interview_id",
     "matches": "^iv-"
    },
    {
     "path": "items",
     "eq": {
      "open": 0,
      "resolved": 0,
      "parked": 0,
      "stale": 0
     }
    },
    {
     "path": "hook_health",
     "eq": {
      "note_prompt": 0,
      "skill_started": 1,
      "check_stop": 0,
      "prompt_seen": false
     }
    }
   ]
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 5,
    "skill": "grill-me",
    "mode": "register"
   },
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "existing",
     "eq": true
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "op": "stop"
  },
  {
   "op": "journal",
   "action": "load"
  },
  {
   "op": "journal",
   "action": "check_events",
   "ended": false
  },
  {
   "op": "journal",
   "action": "assert_events",
   "total": 2,
   "events": [
    {
     "kind": "start",
     "interview_id": "$iid",
     "route": "hook",
     "skill": "grill-me",
     "session_id": "sess-a8",
     "implicit": false,
     "prompt_count": 0
    },
    {
     "kind": "engage",
     "via": "begin_interview"
    }
   ]
  }
 ]
}
