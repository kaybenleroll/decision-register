{
 "id": "S-62b",
 "title": "the decision log is rewritten at every allowed finish attempt (here because the caps are spent, each time with the newer journal position) and on a graceful exit of an active interview with open items, where it is flagged interrupted; the mode is recorded as register",
 "req": [
  "REQ-62",
  "REQ-23",
  "REQ-63"
 ],
 "steps": [
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-62b",
    "prompt": "my answer is below"
   }
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 4,
    "skill": "grill-me",
    "mode": "register"
   },
   "save": {
    "iid": "interview_id"
   }
  },
  {
   "call": "log_item",
   "args": {
    "kind": "question",
    "text": "first open"
   }
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-62b",
    "last_assistant_message": "all done"
   },
   "assert": [
    {
     "decision_block": true
    }
   ]
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-62b",
    "last_assistant_message": "all done"
   },
   "assert": [
    {
     "decision_block": true
    }
   ]
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-62b",
    "last_assistant_message": "all done"
   },
   "assert": [
    {
     "decision_block": false
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "save": {
    "le1": "last_event"
   },
   "assert": [
    {
     "path": "state",
     "eq": "active"
    }
   ]
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "decision-logs/decision-${iid}.md",
     "root": "project",
     "matches": "(?s)\\Ainterview_id: ${iid}\njournal_position: ${le1}\nstate: active\nmode: register\nend_kind: none\nimplicit_start: false\n",
     "mode": "600"
    }
   ]
  },
  {
   "call": "log_item",
   "args": {
    "kind": "question",
    "text": "second open"
   }
  },
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-62b",
    "prompt": "again"
   }
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-62b",
    "last_assistant_message": "all done"
   },
   "assert": [
    {
     "decision_block": true
    }
   ]
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-62b",
    "last_assistant_message": "all done"
   },
   "assert": [
    {
     "decision_block": true
    }
   ]
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-62b",
    "last_assistant_message": "all done"
   },
   "assert": [
    {
     "decision_block": false
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "save": {
    "le2": "last_event"
   },
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "items",
     "eq": {
      "open": 2,
      "resolved": 0,
      "parked": 0,
      "stale": 0
     }
    },
    {
     "path": "last_event",
     "ne": "$le1"
    }
   ]
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "decision-logs/decision-${iid}.md",
     "root": "project",
     "matches": "(?s)\\Ainterview_id: ${iid}\njournal_position: ${le2}\nstate: active\nmode: register\nend_kind: none\nimplicit_start: false\n"
    }
   ]
  },
  {
   "call": "log_item",
   "args": {
    "kind": "question",
    "text": "third open"
   }
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-62b",
    "last_assistant_message": "Q3: third open?"
   },
   "assert": [
    {
     "decision_block": false
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "save": {
    "le3": "last_event"
   },
   "assert": [
    {
     "path": "state",
     "eq": "active"
    }
   ]
  },
  {
   "op": "stop"
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "decision-logs/decision-${iid}.md",
     "root": "project",
     "matches": "(?s)\\Ainterview_id: ${iid}\njournal_position: ${le3}\nstate: [^\\n]+\nmode: register\nend_kind: interrupted\nimplicit_start: false\n",
     "mode": "600"
    }
   ]
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "$key/${iid}.jsonl"
    },
    {
     "path": "$key/${iid}.pid",
     "exists": false
    },
    {
     "path": "$key/archive/${iid}.jsonl",
     "exists": false
    }
   ]
  }
 ]
}
