{
 "id": "S-26a",
 "title": "a hook call (note_prompt, check_stop or skill_started) with a different session id ends an active interview: abandoned with the log flagged and the gate inactive when items are open, normal without the flag when nothing is; the journal is archived",
 "req": [
  "REQ-26"
 ],
 "steps": [
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-26a-0-old",
    "prompt": "my answer is below"
   }
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 4,
    "skill": "grill-me",
    "mode": "register"
   },
   "save": {
    "iid": "interview_id"
   }
  },
  {
   "call": "log_item",
   "args": {
    "id": "q1",
    "kind": "question",
    "text": "open item"
   }
  },
  {
   "call": "log_item",
   "args": {
    "id": "q2",
    "kind": "question",
    "text": "resolved item"
   }
  },
  {
   "call": "resolve",
   "args": {
    "id": "q2",
    "answer": "an",
    "source": "model",
    "rationale": "why"
   }
  },
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-26a-0-new",
    "prompt": "new session prompt"
   }
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "none"
    },
    {
     "path": "interview_id",
     "eq": null
    },
    {
     "path": "items",
     "eq": {
      "open": 0,
      "resolved": 0,
      "parked": 0,
      "stale": 0
     }
    }
   ]
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "$key/${iid}.jsonl",
     "exists": false
    },
    {
     "path": "$key/${iid}.pid",
     "exists": false
    },
    {
     "path": "$key/archive/${iid}.jsonl",
     "nonempty": true
    }
   ]
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "decision-logs/decision-${iid}.md",
     "root": "project",
     "matches": "(?s)\\Ainterview_id: ${iid}\njournal_position: [^\\n]+\nstate: ended\nmode: register\nend_kind: abandoned\nimplicit_start: false\n",
     "mode": "600"
    }
   ]
  },
  {
   "op": "journal",
   "action": "load",
   "where": "archive"
  },
  {
   "op": "journal",
   "action": "check_events",
   "ended": true
  },
  {
   "op": "journal",
   "action": "assert_events",
   "last": {
    "kind": "end",
    "end_kind": "abandoned",
    "mode": "register"
   }
  },
