{
 "id": "S-15h",
 "title": "resume while a pending interview exists stands the pending interview down and the resumed interview takes the given skill as owner_skill",
 "req": [
  "REQ-15",
  "REQ-22",
  "REQ-27",
  "REQ-52"
 ],
 "steps": [
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-15h",
    "prompt": "hi"
   }
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 5,
    "skill": "grill-me",
    "mode": "register"
   },
   "save": {
    "iid": "interview_id"
   }
  },
  {
   "call": "log_item",
   "args": {
    "kind": "question",
    "text": "open 1"
   }
  },
  {
   "op": "kill"
  },
  {
   "op": "start"
  },
  {
   "call": "skill_started",
   "args": {
    "tool_schema": 5,
    "session_id": "sess-15h-2",
    "skill": "grill-me"
   }
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "pending"
    },
    {
     "path": "owner_skill",
     "eq": "grill-me"
    }
   ]
  },
  {
   "call": "resume",
   "args": {
    "skill": "query-walkthrough"
   },
   "assert": [
    {
     "path": "interview_id",
     "eq": "$iid"
    },
    {
     "path": "state",
     "eq": "active"
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "owner_skill",
     "eq": "query-walkthrough"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "op": "stop"
  }
 ]
}
