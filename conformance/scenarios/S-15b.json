{
 "id": "S-15b",
 "title": "status.owner_skill after a begin_interview start (no hook) names the calling skill; a different skill's begin_interview is a no-op that leaves the owner unchanged; a resumed interview reports the owner of its start event again",
 "req": [
  "REQ-15",
  "REQ-21",
  "REQ-22",
  "REQ-52"
 ],
 "steps": [
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-15b",
    "prompt": "start"
   }
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 5,
    "skill": "query-walkthrough",
    "mode": "register"
   },
   "save": {
    "iid": "interview_id"
   },
   "assert": [
    {
     "path": "existing",
     "eq": false
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "owner_skill",
     "eq": "query-walkthrough"
    }
   ]
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 5,
    "skill": "grill-me",
    "mode": "register"
   },
   "assert": [
    {
     "path": "existing",
     "eq": true
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "owner_skill",
     "eq": "query-walkthrough"
    }
   ]
  },
  {
   "call": "log_item",
   "args": {
    "kind": "question",
    "text": "open 1"
   }
  },
  {
   "op": "kill"
  },
  {
   "op": "start"
  },
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-15b-2",
    "prompt": "back"
   }
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "none"
    },
    {
     "path": "owner_skill",
     "eq": null
    }
   ]
  },
  {
   "call": "resume",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "owner_skill",
     "eq": "query-walkthrough"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "op": "stop"
  }
 ]
}
