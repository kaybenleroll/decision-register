{
 "id": "S-23d",
 "title": "the decision log file name carries the interview id and a second interview does not overwrite the first interview's log",
 "req": [
  "REQ-23"
 ],
 "steps": [
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-23d",
    "prompt": "my answer is below"
   }
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 5,
    "skill": "grill-me",
    "mode": "register"
   },
   "save": {
    "iid1": "interview_id"
   }
  },
  {
   "call": "log_item",
   "args": {
    "id": "q1",
    "kind": "question",
    "text": "first interview item"
   }
  },
  {
   "call": "resolve",
   "args": {
    "id": "q1",
    "answer": "an",
    "source": "model",
    "rationale": "why"
   }
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-23d",
    "last_assistant_message": "all done"
   },
   "assert": [
    {
     "decision_block": false
    }
   ]
  },
  {
   "call": "end_interview",
   "args": {},
   "assert": [
    {
     "path": "end_kind",
     "eq": "ended_after_completion"
    }
   ]
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "decision-logs/decision-${iid1}.md",
     "root": "project",
     "matches": "(?m)^interview_id: ${iid1}$"
    }
   ]
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 5,
    "skill": "grill-me",
    "mode": "register"
   },
   "save": {
    "iid": "interview_id"
   }
  },
  {
   "call": "log_item",
   "args": {
    "id": "q1",
    "kind": "question",
    "text": "second interview item"
   }
  },
  {
   "call": "resolve",
   "args": {
    "id": "q1",
    "answer": "an",
    "source": "model",
    "rationale": "why"
   }
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-23d",
    "last_assistant_message": "all done"
   },
   "assert": [
    {
     "decision_block": false
    }
   ]
  },
  {
   "call": "end_interview",
   "args": {}
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "decision-logs/decision-${iid1}.md",
     "root": "project",
     "mode": "600",
     "matches": "(?m)^interview_id: ${iid1}$"
    },
    {
     "path": "decision-logs/decision-${iid}.md",
     "root": "project",
     "mode": "600",
     "matches": "(?m)^interview_id: ${iid}$"
    }
   ]
  }
 ]
}
