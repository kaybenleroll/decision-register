{
 "id": "S-23f",
 "title": "end_interview after the replay step: the log of a complete interview is readable and fresh before it, the end archives the journal and removes the pid file, and the log is not downgraded",
 "req": [
  "REQ-23",
  "REQ-27",
  "REQ-63"
 ],
 "steps": [
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-23f",
    "prompt": "my answer is below"
   }
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 5,
    "skill": "grill-me",
    "mode": "register"
   },
   "save": {
    "iid": "interview_id"
   }
  },
  {
   "call": "log_item",
   "args": {
    "id": "q1",
    "kind": "question",
    "text": "text one"
   }
  },
  {
   "call": "resolve",
   "args": {
    "id": "q1",
    "answer": "an",
    "source": "model",
    "rationale": "why"
   }
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-23f",
    "last_assistant_message": "all done"
   },
   "assert": [
    {
     "decision_block": false
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "save": {
    "le": "last_event"
   },
   "assert": [
    {
     "path": "state",
     "eq": "complete"
    }
   ]
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "decision-logs/decision-${iid}.md",
     "root": "project",
     "matches": "(?m)^journal_position: ${le}$"
    },
    {
     "path": "decision-logs/decision-${iid}.md",
     "root": "project",
     "matches": "(?m)^state: complete$"
    }
   ]
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "$key/${iid}.jsonl"
    },
    {
     "path": "$key/${iid}.pid"
    }
   ]
  },
  {
   "call": "end_interview",
   "args": {},
   "assert": [
    {
     "path": "end_kind",
     "eq": "ended_after_completion"
    },
    {
     "path": "state",
     "eq": "ended"
    }
   ]
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "$key/${iid}.jsonl",
     "exists": false
    },
    {
     "path": "$key/${iid}.pid",
     "exists": false
    },
    {
     "path": "$key/archive/${iid}.jsonl",
     "mode": "600",
     "nonempty": true
    }
   ]
  },
  {
   "op": "journal",
   "action": "load",
   "where": "archive"
  },
  {
   "op": "journal",
   "action": "check_events",
   "ended": true
  },
  {
   "op": "journal",
   "action": "assert_events",
   "count": {
    "end": 1,
    "complete": 1
   },
   "last": {
    "kind": "end",
    "end_kind": "ended_after_completion",
    "mode": "register"
   }
  },
  {
   "op": "fs",
   "assert": [
    {
     "path": "decision-logs/decision-${iid}.md",
     "root": "project",
     "matches": "(?s)\\Ainterview_id: ${iid}\njournal_position: [^\\n]+\nstate: ended\nmode: register\nend_kind: ended_after_completion\nimplicit_start: [^\\n]+\n"
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "none"
    },
    {
     "path": "interview_id",
     "eq": null
    }
   ]
  }
 ]
}
