{
 "id": "S-26e",
 "title": "resume rebinds the resumed interview to last_seen_session_id: the next hook call with that id does not abandon it (the gate applies), whereas a call with another id does",
 "req": [
  "REQ-26",
  "REQ-27",
  "REQ-52"
 ],
 "steps": [
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-26e-old",
    "prompt": "my answer is below"
   }
  },
  {
   "call": "begin_interview",
   "args": {
    "tool_schema": 4,
    "skill": "grill-me",
    "mode": "register"
   },
   "save": {
    "iid": "interview_id"
   }
  },
  {
   "call": "log_item",
   "args": {
    "id": "q1",
    "kind": "question",
    "text": "open item"
   }
  },
  {
   "call": "status",
   "args": {},
   "save": {
    "iid": "interview_id"
   },
   "assert": [
    {
     "path": "state",
     "eq": "active"
    }
   ]
  },
  {
   "op": "stop"
  },
  {
   "op": "start"
  },
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-26e-new",
    "prompt": "after clear"
   }
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "none"
    }
   ]
  },
  {
   "call": "resume",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    }
   ]
  },
  {
   "call": "check_stop",
   "args": {
    "session_id": "sess-26e-new",
    "last_assistant_message": "all done"
   },
   "assert": [
    {
     "decision_block": true
    },
    {
     "path": "reason",
     "contains": "q1"
    }
   ]
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "active"
    },
    {
     "path": "interview_id",
     "eq": "$iid"
    },
    {
     "path": "items",
     "eq": {
      "open": 1,
      "resolved": 0,
      "parked": 0,
      "stale": 0
     }
    }
   ]
  },
  {
   "op": "journal",
   "action": "load"
  },
  {
   "op": "journal",
   "action": "assert_events",
   "count": {
    "resume": 1
   },
   "events": [
    {
     "kind": "resume",
     "session_id": "sess-26e-new"
    }
   ]
  },
  {
   "call": "note_prompt",
   "args": {
    "session_id": "sess-26e-other",
    "prompt": "my answer is below"
   }
  },
  {
   "call": "status",
   "args": {},
   "assert": [
    {
     "path": "state",
     "eq": "none"
    },
    {
     "path": "interview_id",
     "eq": null
    }
   ]
  },
  {
   "op": "journal",
   "action": "load",
   "where": "archive"
  },
  {
   "op": "journal",
   "action": "check_events",
   "ended": true
  },
  {
   "op": "journal",
   "action": "assert_events",
   "last": {
    "kind": "end",
    "end_kind": "abandoned",
    "mode": "register"
   }
  }
 ]
}
