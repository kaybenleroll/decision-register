#!/bin/sh
# Launcher for the register MCP server (REQ-73, REQ-77). The plugin always starts the server here.
#   REGSPIKE_IMPL unset or rs : the regspike-rs binary found on PATH
#   REGSPIKE_IMPL=ts          : node <repo>/impl/ts/dist/regspike.mjs (REGSPIKE_TS_BUNDLE overrides the path)
#   REGSPIKE_IMPL=off or any other value, or the chosen implementation is missing: a no-op stub server
# A missing implementation is never reported as success: one line goes to stderr and the stub answers
# {"unavailable": ...} to status. Hook-facing tools return {} so hooks in unrelated sessions never block.
here=$(cd "$(dirname "$0")" && pwd -P) || exit 1
impl=${REGSPIKE_IMPL:-rs}

stub() { # $1 stderr message, $2 reason reported by status
    echo "$1" >&2
    REGSPIKE_STUB_REASON=$2
    export REGSPIKE_STUB_REASON
    exec python3 -I "$here/register-stub.py"
}

case $impl in
rs)
    if command -v regspike-rs >/dev/null 2>&1; then
        exec regspike-rs
    fi
    stub "register unavailable: binary not found" "binary not found"
    ;;
ts)
    bundle=${REGSPIKE_TS_BUNDLE:-$here/../../impl/ts/dist/regspike.mjs}
    if [ -f "$bundle" ] && command -v node >/dev/null 2>&1; then
        exec node "$bundle"
    fi
    stub "register unavailable: binary not found" "binary not found"
    ;;
off)
    stub "register off: REGSPIKE_IMPL=off" "disabled by REGSPIKE_IMPL=off"
    ;;
*)
    stub "register off: unknown REGSPIKE_IMPL=$impl" "unknown REGSPIKE_IMPL"
    ;;
esac
